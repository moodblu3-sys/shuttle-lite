# Shuttle Lite environment
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# fake: no Box credentials needed. Content is stored under .shuttle-lite/fake-box.
# real: talk to a Box enterprise through the configured proxy.
BOX_MODE=fake
SHUTTLE_DATA_DIR=.shuttle-lite
# Must be on local disk. A network share or a sync folder corrupts SQLite WAL,
# so startup refuses one unless ALLOW_UNSAFE_STATE_PATH=true.
# On Windows use a local path such as C:\ProgramData\ShuttleLite\shuttle-lite.db
SQLITE_PATH=.shuttle-lite/shuttle-lite.db
ALLOW_UNSAFE_STATE_PATH=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Box (required only when BOX_MODE=real)
# ---------------------------------------------------------------------------
# 開発・デモ用: トークン本体だけを設定する（Bearerは不要）。
# 設定されている間はCCGより優先し、無効・期限切れでもCCGへ切り替えない。
# Developer Tokenは60分で失効。新しいトークンに差し替え、web/workerを再起動する。
BOX_ACCESS_TOKEN=
# BOX_ACCESS_TOKENが空のときは、次の3項目でCCG認証する。
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Client Credentials Grant subject. Use the enterprise ID for a Service Account.
BOX_ENTERPRISE_ID=
BOX_API_BASE_URL=https://api.box.com/2.0
BOX_UPLOAD_BASE_URL=https://upload.box.com/api/2.0
BOX_AUTH_BASE_URL=https://api.box.com/oauth2
BOX_METADATA_TEMPLATE_KEY=shuttleLiteMigration
BOX_METADATA_SCOPE=enterprise

# Box folder IDs created by `npm run bootstrap:box` (left for the integration step).
BOX_ROOT_FOLDER_ID=
BOX_STAGING_FOLDER_ID=
BOX_NEEDS_REVIEW_FOLDER_ID=
BOX_REPORTS_FOLDER_ID=

# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------
# proxyは前提条件ではない。既定は直接接続。
# off       : 直接接続する
# preferred : proxyが設定されていれば経由し、無ければ直接接続する
# required  : proxy経由のみ。使えなければ直接接続へfallbackせず停止する
PROXY_MODE=off
PROXY_URL=
PROXY_AUTH_MODE=none
PROXY_USERNAME=
PROXY_PASSWORD=
# Absolute or repo-relative path to an extra CA bundle in PEM format.
# TLS検証を無効化する設定は用意していない。
PROXY_CA_BUNDLE_PATH=
NO_PROXY=localhost,127.0.0.1
# 認証はnoneとBasicのみ（NTLM/Kerberos/PACは対象外）。
# 手元でproxy経路を試すなら infra/squid/README.md の npm run squid:start を使う。
# required + Basic の構成で実Boxへの移行を通している（docs/acceptance.md）。

# ---------------------------------------------------------------------------
# Concurrency and limits
# ---------------------------------------------------------------------------
# Application limits: FILE_CONCURRENCY 1..5, CHUNK_CONCURRENCY 1..4
FILE_CONCURRENCY=3
CHUNK_CONCURRENCY=3
DIRECT_UPLOAD_MAX_BYTES=52428800
MAX_FILE_BYTES=16106127360
MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# AI routing
# ---------------------------------------------------------------------------
AI_ROUTING_ENABLED=true
AI_MAX_ATTEMPTS=4

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# jsonl: append delivered events to .shuttle-lite/telemetry/events.jsonl
# snowflake: SQL API + key-pair authentication. See docs/settings.md.
# Once saved in the UI, editable settings in SQLite take precedence over these defaults.
TELEMETRY_SINK=jsonl
TELEMETRY_BATCH_SIZE=50
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_TABLE=SHUTTLE_LITE_EVENTS

# ---------------------------------------------------------------------------
# Fake Box gateway behaviour (demo and test only)
# ---------------------------------------------------------------------------
# Return a pending representation on the first AI call for each file.
FAKE_BOX_AI_PENDING_FIRST_CALL=false
# Inject one 429 with Retry-After per upload attempt sequence.
FAKE_BOX_RATE_LIMIT_EVERY=0
# Artificial delay per upload chunk in milliseconds. Makes the progress UI visible.
FAKE_BOX_LATENCY_MS=0
